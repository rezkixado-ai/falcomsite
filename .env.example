# Copy this file to .env for local development with `netlify dev`.
# In production, set these same keys under Netlify → Site configuration →
# Environment variables (NOT in this file — never commit real secrets).

# Turso database — get these from `turso db show <db-name>` after creating
# a database at https://turso.tech (free tier is enough for this site).
# Leave both blank to fall back to a local SQLite file (db/local.db) for
# quick local testing without a Turso account.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Random long string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

NODE_ENV=development
